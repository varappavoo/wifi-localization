<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Wi-Fi RSSI Localization" android:textSize="26sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="3 anchors • RSSI → distance → trilateration" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/scanButton" android:text="Scan Wi-Fi and Locate" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/statusText" android:text="Grant permissions, enable Wi-Fi, then scan." android:textSize="17sp" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<com.example.wifilocalization.LocalizationView android:id="@+id/localizationView" android:layout_width="match_parent" android:layout_height="420dp"/>
<TextView android:id="@+id/resultsText" android:textSize="16sp" android:fontFamily="monospace" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>